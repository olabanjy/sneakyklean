# Django settings
DEBUG=False
SECRET_KEY=replace-with-a-long-random-secret
ALLOWED_HOSTS=localhost,127.0.0.1,your-domain.com,www.your-domain.com
HOST_WEB_PORT=8000

# Database
DB_NAME=sneakyklean_db
DB_USER=sneakyklean_user
DB_PASSWORD=replace-with-a-strong-password

# Email settings
EMAIL_HOST=smtp.zoho.com
EMAIL_PORT=587
EMAIL_HOST_USER=your-email@yourdomain.com
EMAIL_HOST_PASSWORD=replace-with-email-password
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=Sneaky Klean <noreply@yourdomain.com>

# Admin
ADMIN_EMAIL=admin@yourdomain.com

# ZeptoMail API
ZEPTO_API_KEY=replace-with-zeptomail-api-key
ZEPTO_API_BASE_URL=https://api.zeptomail.com/v1.1
